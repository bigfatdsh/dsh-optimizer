{
  "name": "dsh-optimizer",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "优化插件集：把省 token 的开关收在输入栏右侧的「优化」面板里，共十个开关。执行侧：并行工具调用纪律、失败重放（只发改动字段）、复读抑制、按任务换档；上下文侧：工具结果发送前上限+落盘、不动已发内容（让内置裁剪器无事可做）、工具说明按需加载、提前自动压缩；另有精简化输出与花费预警。所有失败方向都是\"原样工作\"，不会让请求失败。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "cost",
    "optimizer",
    "parallel-tool-calls",
    "retry",
    "context",
    "compaction",
    "prompt-cache",
    "lazy-tools",
    "guard"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "bench-report.md",
    "bench-report.json"
  ],
  "meta": {
    "title": "优化插件集",
    "description": "十个开关，全部挂在宿主公开契约的钩子上：并行纪律、失败重放、结果上限、不动已发内容、复读抑制、按需加载、提前压缩、按任务换档、精简化输出、花费预警。没有一处包住模型调用。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "verify": "node tools/verify-client-bundle.mjs",
    "bench": "node tools/bench.mjs",
    "live": "node tools/live-verify.mjs"
  }
}
