{
  "name": "dsh-optimizer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "优化插件集：把省 token 的开关收在一个「优化」面板里。当前含「精简化输出」——在系统提示词最后追加一段输出纪律，压掉开场白、复述与装饰性小节，任务内容一字不改；输入栏右侧「优化」图标开关，改动下一个模型步骤即生效。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "reasoning-effort",
    "thinking",
    "auto",
    "token"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/classify.js",
    "lib/request.js",
    "lib/schema.js",
    "lib/state.js",
    "lib/efforts.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "meta": {
    "title": "推理等级 Auto Effort",
    "description": "在请求发出前按任务轻重判定推理档位，落成该模型真正支持的 effort；判不出就停在原样，续跑不中途改口径。默认自动，可切成「仅未手动选择时生效」或完全关闭。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/plugin.test.js test/client.test.js",
    "verify:client": "node tools/verify-client-bundle.mjs",
    "verify": "node tools/verify-client-bundle.mjs"
  }
}
